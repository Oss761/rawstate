{% render 'entete', actif: 'journal' %}
  <main id="top">
    <section class="container" style="padding-block: clamp(48px,7vw,90px); max-width:820px;">
      <div style="text-align:center; margin-bottom:40px;">
        <span class="eyebrow">Journal</span>
        <h1 style="font-size:clamp(28px,4vw,48px); letter-spacing:-0.03em;">{{ blog.title }}</h1>
      </div>
      <div style="display:grid; gap:32px;">
        {% for article in blog.articles %}
          <a href="{{ article.url }}" style="display:block;">
            {% if article.image %}<img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" style="border-radius:var(--radius-sm); margin-bottom:14px;" />{% endif %}
            <h2 style="font-size:22px;">{{ article.title }}</h2>
            <p style="color:var(--grey-600);">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
          </a>
        {% endfor %}
      </div>
    </section>
  </main>
