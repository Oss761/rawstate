    <section class="container" style="min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; gap:22px; padding:60px 0;">
      <img src="{{ 'logo-dark.svg' | asset_url }}" alt="Rawstate" style="height:34px;" />
      <span class="eyebrow">Ouverture imminente</span>
      <h1 style="font-size:clamp(30px,5vw,54px); letter-spacing:-0.04em;">Bientôt disponible</h1>
      <p style="color:var(--grey-600); max-width:440px;">Notre boutique arrive très bientôt. Entrez le mot de passe pour y accéder.</p>
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
          <input type="password" name="password" placeholder="Mot de passe" style="padding:14px 18px; border:1px solid var(--line-strong); border-radius:100px; min-width:220px;" />
          <button type="submit" class="btn btn--dark">Entrer</button>
        </div>
      {% endform %}
    </section>
