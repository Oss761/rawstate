{% render 'entete' %}
  <main id="top">
    <section class="container" style="padding-block: clamp(48px,7vw,90px); max-width:820px;">
      <h1 style="font-size:clamp(28px,4vw,44px); letter-spacing:-0.03em; margin-bottom:28px;">Votre panier</h1>
      {% if cart.item_count > 0 %}
        {% form 'cart', cart %}
          {% for item in cart.items %}
            <div style="display:flex; gap:18px; align-items:center; padding:18px 0; border-bottom:1px solid var(--line);">
              {% if item.image %}<img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" style="width:70px; border-radius:8px;" />{% endif %}
              <div style="flex:1;">
                <strong>{{ item.product.title }}</strong><br />
                <span style="color:var(--grey-600); font-size:14px;">{{ item.variant.title }}</span>
              </div>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:64px; padding:8px; border:1px solid var(--line-strong); border-radius:8px;" />
              <span style="min-width:90px; text-align:right; font-weight:600;">{{ item.final_line_price | money }}</span>
            </div>
          {% endfor %}
          <div style="display:flex; justify-content:space-between; align-items:center; margin:28px 0;">
            <button type="submit" name="update" class="btn btn--ghost">Mettre à jour</button>
            <div style="font-size:20px;">Total : <strong>{{ cart.total_price | money }}</strong></div>
          </div>
          <button type="submit" name="checkout" class="btn btn--dark btn--block btn--lg">Passer commande</button>
        {% endform %}
      {% else %}
        <p style="color:var(--grey-600); margin-bottom:28px;">Votre panier est vide.</p>
        <a href="{{ routes.root_url }}" class="btn btn--dark btn--lg">Retour à la boutique</a>
      {% endif %}
    </section>
  </main>
