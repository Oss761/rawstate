{% render 'entete' %}
  <main id="top">
    <section class="container" style="padding-block: clamp(48px,7vw,90px);">
      <div style="text-align:center; margin-bottom:40px;">
        <span class="eyebrow">Boutique</span>
        <h1 style="font-size:clamp(28px,4vw,48px); letter-spacing:-0.03em;">Collections</h1>
      </div>
      <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:28px;">
        {% for collection in collections %}
          <a href="{{ collection.url }}">
            {% if collection.featured_image %}
              <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.title | escape }}" style="border-radius:var(--radius-sm); margin-bottom:12px;" />
            {% endif %}
            <strong>{{ collection.title }}</strong>
          </a>
        {% endfor %}
      </div>
    </section>
  </main>
