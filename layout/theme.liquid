<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {%- liquid
    assign cle = template.name
    if template.name == 'product'
      assign cle = 'p:' | append: product.handle
    elsif template.name == 'page'
      assign cle = 'g:' | append: page.handle
    endif
    assign classe = ''
  -%}
  {%- case cle -%}
  {%- when 'index' -%}
    {%- assign classe = 'page-shop' -%}
    <title>Rawstate — Tapis de yoga pliables et accessoires</title>
    <meta name="description" content="La boutique Rawstate : The Fold, le tapis de yoga pliable, le tapis en liège The Grip et les accessoires. Livraison offerte, 30 jours pour essayer." />
  {%- when 'p:rawstate-the-fold' -%}
    {%- assign classe = '' -%}
    <title>Tapis pliable The Fold — Le tapis de yoga pliable qui se range partout</title>
    <meta name="description" content="Tapis pliable The Fold — le tapis de yoga pliable premium. Ultra léger, compact, stable. Pensé pour ceux qui pratiquent partout." />
  {%- when 'p:tapis-liege' -%}
    {%- assign classe = 'page-pdp' -%}
    <title>Tapis de yoga The Grip — Rawstate</title>
    <meta name="description" content="Surface en liège naturel sur base TPE. Plus la main est humide, meilleure est l'adhérence." />
  {%- when 'p:planche-acupression' -%}
    {%- assign classe = 'page-pdp' -%}
    <title>Planche d'acupression The Board — Rawstate</title>
    <meta name="description" content="Une planche ronde à picots et billes métalliques pour détendre la voûte plantaire après une journée debout." />
  {%- when 'p:bloc-yoga' -%}
    {%- assign classe = 'page-pdp' -%}
    <title>Bloc de yoga The Block — Rawstate</title>
    <meta name="description" content="Un bloc en mousse EVA pour aller chercher une posture sans forcer. Trois hauteurs selon la face posée." />
  {%- when 'p:roue-liege' -%}
    {%- assign classe = 'page-pdp' -%}
    <title>Roue de yoga The Wheel — Rawstate</title>
    <meta name="description" content="Un appui circulaire pour les extensions arrière, les étirements et le relâchement du dos. 30 cm, 770 g." />
  {%- when 'p:chaussettes-antiderapantes' -%}
    {%- assign classe = 'page-pdp' -%}
    <title>Chaussettes The Socks — Rawstate</title>
    <meta name="description" content="Picots de silicone sous la semelle. L'adhérence du pied nu, en gardant les pieds couverts." />
  {%- when 'p:gants-antiderapants' -%}
    {%- assign classe = 'page-pdp' -%}
    <title>Gants de yoga The Gloves — Rawstate</title>
    <meta name="description" content="Le pendant des chaussettes, pour les appuis sur les mains. Doigts libres, paume à picots." />
  {%- when 'p:gourde-transparente' -%}
    {%- assign classe = 'page-pdp' -%}
    <title>Gourde The Bottle — Rawstate</title>
    <meta name="description" content="650 mL, bouchon à clapet et dragonne. Transparente : on voit ce qu'on a bu, et ce qu'il reste." />
  {%- when 'p:rituel-essentiel' -%}
    {%- assign classe = 'page-pdp' -%}
    <title>Rituel L'Essentiel — Rawstate</title>
    <meta name="description" content="Pour commencer chez soi, sans rien connaître au yoga. Le pack complet à prix rond, moins cher qu’à l’unité." />
  {%- when 'p:rituel-studio' -%}
    {%- assign classe = 'page-pdp' -%}
    <title>Rituel Le Studio — Rawstate</title>
    <meta name="description" content="Le niveau studio, sans sortir de chez vous. Le pack complet à prix rond, moins cher qu’à l’unité." />
  {%- when 'p:rituel-recup' -%}
    {%- assign classe = 'page-pdp' -%}
    <title>Rituel La Récup' — Rawstate</title>
    <meta name="description" content="La détente plantaire, après la journée debout. Le pack complet à prix rond, moins cher qu’à l’unité." />
  {%- when 'g:rituels' -%}
    {%- assign classe = 'page-rituels' -%}
    <title>Les Rituels Rawstate — packs yoga complets</title>
    <meta name="description" content="Trois rituels Rawstate : L'Essentiel, Le Studio et La Récup'. Des packs complets (tapis, bloc, chaussettes, roue, acupression, gourde) à prix rond, livraison offerte." />
  {%- when 'g:mentions-legales' -%}
    {%- assign classe = '' -%}
    <title>Mentions légales — Rawstate</title>
    <meta name="description" content="Mentions légales du site Rawstate — éditeur, hébergeur, propriété intellectuelle et informations légales." />
  {%- when 'g:confidentialite' -%}
    {%- assign classe = '' -%}
    <title>Politique de confidentialité — Rawstate</title>
    <meta name="description" content="Politique de confidentialité de Rawstate — traitement des données personnelles conforme au RGPD, finalités, durées de conservation et vos droits." />
  {%- when 'g:cgv' -%}
    {%- assign classe = '' -%}
    <title>Conditions Générales de Vente — Rawstate</title>
    <meta name="description" content="Conditions Générales de Vente (CGV) de Rawstate — produits, offres et cadeaux, prix, commande, paiement, livraison offerte, droit de rétractation et garanties." />
  {%- when 'g:politique-retour' -%}
    {%- assign classe = '' -%}
    <title>Politique de retour — Rawstate</title>
    <meta name="description" content="Politique de retour et de remboursement Rawstate : délai de rétractation, garantie satisfait ou remboursé de 30 jours (90 jours pour l'offre 2 tapis The Fold), conditions, démarche de retour, frais et délais de remboursement." />
  {%- else -%}
    <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}" />{%- endif -%}
  {%- endcase %}
  <link rel="canonical" href="{{ canonical_url }}" />
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}" />
  <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}" />
  <!-- Preload de l'image hero (LCP) -->

  <!-- Polices auto-hebergees + CSS critique du premier ecran (inline, non-bloquant) -->
