          <a href="/pages/politique-retour">Politique de retour</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Cart drawer -->
  <div class="cart-overlay" data-cart-overlay></div>
  <aside class="cart" data-cart aria-hidden="true" aria-label="Panier">
    <div class="cart__head">
      <img class="cart__logo" src="{{ 'logo-dark.png' | asset_url }}" alt="Rawstate" loading="lazy" />
      <button class="cart__close" data-cart-close aria-label="Fermer le panier">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="cart__titlerow">
      <h3>Votre panier</h3>
      <span data-cart-count-label>0 article</span>
    </div>
    <div class="cart__body">
      <p class="cart__empty" data-cart-empty>Votre panier est vide.</p>
      <div class="cart__items" data-cart-items></div>
      <div class="cart-gifts" data-cart-gifts hidden>
        <p class="cart-gifts__title">Inclus dans votre commande</p>
        <ul class="cart-gifts__list" data-cart-gifts-list></ul>
      </div>
      <div class="cart-upsell" data-upsell hidden>
        <p class="cart-upsell__txt"><strong>Ajoutez un 2ᵉ tapis</strong> et économisez 21&nbsp;€</p>
        <div class="cart-upsell__pick">
          <span class="cart-upsell__label">Coloris du 2ᵉ&nbsp;:</span>
          <div class="cart-upsell__swatches" data-upsell-swatches></div>
        </div>
      </div>
    </div>
    <div class="cart__foot">
      <div class="cart__line"><span>Sous-total</span><span data-cart-subtotal>0,00 €</span></div>
      <div class="cart__line"><span>Livraison</span><span data-cart-shipping>—</span></div>
      <div class="cart__total"><span>Total</span><strong data-cart-total>0,00 €</strong></div>
      <button class="btn btn--dark btn--block cart__checkout">Passer commande</button>
      <p class="cart__foot-line" data-cart-eta-line hidden><span class="ico" data-ico="truck"></span> <span data-cart-eta></span></p>
