/* =========================================================
   RAWSTATE — Premium monochrome landing
   Palette: #FFF · #F5F5F5 · #D9D9D9 · #666 · #111 · #000
   ========================================================= */

:root {
  --white: #ffffff;
  --grey-100: #f5f5f5;
  --grey-300: #d9d9d9;
  --grey-600: #666666;
  --ink-900: #111111;
  --black: #000000;

  --bg: #F7F3EC;
  --accent: #2E6B67;
  --accent-dark: #245450;

  --line: #ececec;
  --line-strong: #d9d9d9;

  --maxw: 1240px;
  --pad: clamp(20px, 5vw, 64px);
  --radius: 18px;
  --radius-sm: 12px;

  --ease: cubic-bezier(.22, 1, .36, 1);
  --dur: .35s;

  --shadow-sm: 0 1px 2px rgba(0,0,0,.04), 0 4px 16px rgba(0,0,0,.04);
  --shadow-md: 0 4px 12px rgba(0,0,0,.05), 0 24px 48px rgba(0,0,0,.08);

  --font: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', system-ui, sans-serif;
  --font-display: 'Archivo', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  /* titres : H1 et titres de section (variable, l'axe opsz s'adapte au corps) */
  --font-title: 'Fraunces', Georgia, 'Times New Roman', serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

body {
  font-family: var(--font);
  color: var(--ink-900);
  background: var(--bg);
  line-height: 1.55;
  font-weight: 400;
  letter-spacing: -0.01em;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; border: none; background: none; }

.container { width: 100%; max-width: var(--maxw); margin-inline: auto; padding-inline: var(--pad); }

/* ---------- Typography helpers ---------- */
h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }
h1 { font-family: var(--font-title); }
h2 { font-family: var(--font-title); font-weight: 600; }
.eyebrow {
  display: inline-block;
  font-size: 12px; font-weight: 600; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--grey-600); margin-bottom: 18px;
}
.eyebrow--light { color: rgba(255,255,255,.7); }

/* ---------- Reveal animation ---------- */
.reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
.reveal.is-in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .reveal { opacity: 1; transform: none; transition: none; }
  html { scroll-behavior: auto; }
}

/* =========================================================
   BUTTONS
   ========================================================= */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  font-weight: 500; font-size: 15px; letter-spacing: -0.01em;
  border-radius: 100px; padding: 14px 26px;
  transition: transform var(--dur) var(--ease), background var(--dur) var(--ease),
              color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), opacity var(--dur) var(--ease);
  will-change: transform;
}
.btn--sm { padding: 10px 20px; font-size: 14px; }
.btn--lg { padding: 17px 34px; font-size: 16px; }
.btn--block { width: 100%; }

.btn--dark { background: var(--accent); color: var(--white); }
.btn--dark:hover { background: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 12px 28px rgba(0,0,0,.22); }
.btn--dark:active { transform: translateY(0); }

.btn--ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
.btn--ghost:hover { background: rgba(46,107,103,.08); border-color: var(--accent-dark); transform: translateY(-2px); }

.btn--white { background: var(--accent); color: var(--white); }
.btn--white:hover { background: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 12px 28px rgba(46,107,103,.35); }
.btn--ghost-light { background: rgba(255,255,255,.06); color: var(--white); border: 1px solid rgba(255,255,255,.4); backdrop-filter: blur(4px); }
.btn--ghost-light:hover { background: rgba(255,255,255,.14); border-color: var(--white); transform: translateY(-2px); }

.btn__price { opacity: .6; font-weight: 400; }

.section-cta { text-align: center; margin-top: clamp(36px, 5vw, 56px); }

/* =========================================================
   ANNOUNCE + HEADER
   ========================================================= */
.announce {
  background: var(--accent); color: var(--white);
  font-size: 12.5px; letter-spacing: 0.04em; font-weight: 400;
  padding: 9px 0; overflow: hidden;
}
/* Un message a la fois : le sortant glisse vers le bas, l'entrant vient du haut.
   overflow sur la piste (et pas seulement sur .announce) : sinon les messages en
   attente se verraient dans les 9 px de padding. */
.announce__track { position: relative; height: 1.45em; overflow: hidden; }
.announce__item {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  white-space: nowrap; opacity: .92; transform: translateY(-100%);
  transition: transform .55s var(--ease), opacity .55s var(--ease);
}
.announce__item.is-in { transform: translateY(0); }
.announce__item.is-out { transform: translateY(100%); opacity: 0; }
@media (prefers-reduced-motion: reduce) { .announce__item { transition: none; } }

.header {
  position: sticky; top: 0; z-index: 100;
  background: #111111;
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid transparent;
  transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
}
.header.is-scrolled { border-bottom-color: rgba(255,255,255,.1); box-shadow: 0 1px 20px rgba(0,0,0,.2); }
.header__inner { display: flex; align-items: center; justify-content: space-between; height: 66px; }

.logo { display: inline-flex; align-items: center; }
.logo img { height: 22px; width: auto; display: block; }
.logo--footer img { height: 26px; }

.nav { display: flex; gap: 34px; }
.nav a {
  font-size: 14.5px; color: rgba(255,255,255,.8); font-weight: 450;
  position: relative; transition: color var(--dur) var(--ease);
}
.nav a::after {
  content: ''; position: absolute; left: 0; bottom: -4px; height: 1px; width: 0;
  background: var(--accent); transition: width var(--dur) var(--ease);
}
.nav a:hover { color: #ffffff; }
.nav a:hover::after { width: 100%; }

.header__actions { display: flex; align-items: center; gap: 14px; }
.header__cart {
  display: inline-flex; align-items: center; justify-content: center;
  width: 38px; height: 38px; border-radius: 50%;
  transition: background var(--dur) var(--ease);
}
.header__cart { position: relative; }
.header__cart:hover { background: rgba(255,255,255,.1); }
.header__cart .ico { width: 21px; height: 21px; color: var(--accent); }
.header__cart-count {
  position: absolute; top: -1px; right: -1px; min-width: 18px; height: 18px; padding: 0 4px;
  border-radius: 100px; background: var(--accent); color: #fff;
  font-size: 11px; font-weight: 600; line-height: 18px; text-align: center;
  border: 2px solid #111111; box-sizing: content-box;
  animation: cartpop .3s var(--ease);
}
@keyframes cartpop { from { transform: scale(0); } to { transform: scale(1); } }

/* ---------- Cart drawer ---------- */
.cart-overlay {
  position: fixed; inset: 0; z-index: 200; background: rgba(17,17,17,.45);
  opacity: 0; visibility: hidden; transition: opacity var(--dur) var(--ease), visibility var(--dur) var(--ease);
  backdrop-filter: blur(2px);
}
.cart-overlay.is-open { opacity: 1; visibility: visible; }
.cart {
  position: fixed; top: 0; right: 0; z-index: 201; height: 100%;
  width: min(420px, 100%); background: var(--white);
  display: flex; flex-direction: column;
  transform: translateX(100%); transition: transform .4s var(--ease);
  box-shadow: -20px 0 60px rgba(0,0,0,.16);
}
.cart.is-open { transform: translateX(0); }
.cart__head { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px; border-bottom: 1px solid var(--line); }
.cart__logo { height: 20px; width: auto; }
.cart__close { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; color: var(--ink-900); transition: background var(--dur) var(--ease); }
.cart__close:hover { background: var(--grey-100); }
.cart__close svg { width: 20px; height: 20px; }
.cart__titlerow { display: flex; align-items: baseline; justify-content: space-between; padding: 22px 24px 6px; }
.cart__titlerow h3 { font-size: 22px; letter-spacing: -0.03em; }
.cart__titlerow span { font-size: 13px; color: var(--grey-600); }
.cart__body { flex: 1; overflow-y: auto; padding: 12px 24px; }
.cart__empty { text-align: center; color: var(--grey-600); font-size: 15px; padding: 60px 0; line-height: 1.7; }

.cart-item { display: flex; gap: 14px; justify-content: space-between; padding: 18px 0; border-bottom: 1px solid var(--line); }
.cart-item__info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.cart-item__info strong { font-size: 14.5px; letter-spacing: -0.01em; }
.cart-item__info > span { font-size: 12.5px; color: var(--grey-600); }
.cart-item__qty { display: inline-flex; align-items: center; gap: 0; border: 1px solid var(--line-strong); border-radius: 100px; margin-top: 8px; width: fit-content; overflow: hidden; }
.cart-item__qty button { width: 28px; height: 28px; font-size: 15px; color: var(--ink-900); display: grid; place-items: center; transition: background var(--dur) var(--ease); }
.cart-item__qty button:hover { background: var(--grey-100); }
.cart-item__qty span { min-width: 24px; text-align: center; font-size: 13px; font-weight: 500; }
.cart-item__right { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }
.cart-item__price { font-size: 14.5px; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
.cart-item__remove { font-size: 12px; color: var(--grey-600); text-decoration: underline; text-underline-offset: 2px; transition: color var(--dur) var(--ease); }
.cart-item__remove:hover { color: var(--ink-900); }

.cart__foot { border-top: 1px solid var(--line); padding: 18px 24px calc(18px + env(safe-area-inset-bottom)); display: grid; gap: 10px; }
.cart__line { display: flex; align-items: baseline; justify-content: space-between; font-size: 14px; color: var(--grey-600); }
.cart__line [data-cart-shipping].is-free { color: var(--ink-900); font-weight: 600; }
.cart__total { display: flex; align-items: baseline; justify-content: space-between; padding-top: 10px; margin-top: 2px; border-top: 1px solid var(--line); }
.cart__total span { font-size: 14px; color: var(--grey-600); }
.cart__total strong { font-size: 22px; letter-spacing: -0.03em; color: var(--ink-900); }
.cart__checkout { padding: 17px; margin-top: 4px; }
.cart__secure { display: flex; align-items: center; justify-content: center; gap: 7px; font-size: 12px; color: var(--grey-600); }
.cart__secure .ico { width: 14px; height: 14px; }

/* Hamburger (mobile only) */
.header__burger { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 40px; height: 40px; }
.header__burger span { display: block; width: 22px; height: 2px; margin: 0 auto; background: var(--accent); border-radius: 2px; transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease); }
/* le bouton n'a que 2 barres : elles se croisent au centre (ecart 5 px + epaisseur 2 px = 7 px) */
.header.is-menu-open .header__burger span:nth-child(1) { transform: translateY(3.5px) rotate(45deg); }
.header.is-menu-open .header__burger span:nth-child(2) { transform: translateY(-3.5px) rotate(-45deg); }

/* Mobile dropdown menu */
.header__mobile {
  display: none; flex-direction: column; gap: 2px;
  /* flotte sous le header : l'ouvrir ou le fermer ne decale pas la page
     (sinon un lien vers une section de la page atterrit trop bas) */
  position: absolute; top: 100%; left: 0; right: 0;
  box-shadow: 0 18px 30px rgba(0,0,0,.12);
  background: rgba(255,255,255,.96); backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid transparent;
  padding-inline: var(--pad);
  max-height: 0; overflow: hidden;
  transition: max-height var(--dur) var(--ease), padding var(--dur) var(--ease), border-color var(--dur) var(--ease);
}
.header__mobile a:not(.btn) {
  font-size: 17px; font-weight: 450; color: var(--ink-900);
  padding: 15px 0; border-bottom: 1px solid var(--line);
}
.header__mobile a:not(.btn):last-of-type { border-bottom: none; }
.header__mobile .btn { margin-top: 16px; }
.header.is-menu-open .header__mobile { max-height: 420px; padding-top: 8px; padding-bottom: 24px; border-bottom-color: var(--line); }

/* une section visee par une ancre s'arrete sous le header collant (66 px), pas derriere */
main section[id] { scroll-margin-top: 66px; }

/* =========================================================
   HERO
   ========================================================= */
.hero { position: relative; overflow: hidden; isolation: isolate; }

.hero__bg { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
.hero__bg img, .hero__bg video {
  position: absolute; left: 0; top: -80px;
  width: 100%; height: calc(100% + 160px);
  object-fit: cover; object-position: center 48%;
  filter: brightness(.95) contrast(1.02);
  will-change: transform;
}
.hero__img { display: block; }
/* Cadrage mobile de l'image portrait (sélectionnée via <source media> du <picture>) */
@media (max-width: 620px) {
  .hero__bg img { object-position: center 40%; }
}
.hero__overlay {
  position: absolute; inset: 0; z-index: -1;
  background:
    linear-gradient(180deg, rgba(0,0,0,.34) 0%, rgba(0,0,0,.2) 45%, rgba(0,0,0,.4) 100%),
    radial-gradient(ellipse 70% 60% at 50% 50%, rgba(0,0,0,.24), rgba(0,0,0,0) 75%);
}

.hero__inner {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-height: min(92vh, 880px);
  padding-block: 80px; text-align: center;
}
.hero__content { width: 100%; max-width: 1000px; min-width: 0; margin-inline: auto; text-shadow: 0 1px 12px rgba(0,0,0,.5); }
.hero__cta .btn { text-shadow: none; }

.badge {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 12.5px; font-weight: 500; letter-spacing: 0.02em;
  color: rgba(255,255,255,.9); background: rgba(255,255,255,.1);
  border: 1px solid rgba(255,255,255,.24); backdrop-filter: blur(8px);
  border-radius: 100px; padding: 7px 16px; margin-bottom: 28px;
}
.badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--white); }

.hero__title {
  font-family: var(--font-title);
  font-size: clamp(34px, 5.4vw, 76px); font-weight: 700;
  letter-spacing: -0.02em; line-height: 1.06; margin-bottom: 26px;
  color: #fff;
  text-shadow: 0 2px 20px rgba(0,0,0,.55), 0 1px 3px rgba(0,0,0,.35);
}
.hero__title-light { color: rgba(255,255,255,.55); }

.hero__sub {
  font-size: clamp(16px, 1.6vw, 19px); color: rgba(255,255,255,.82);
  max-width: 560px; margin: 0 auto 38px; line-height: 1.6;
}
.hero__cta { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-bottom: 22px; }

.hero__perks {
  list-style: none; display: flex; flex-wrap: wrap; justify-content: center;
  gap: 12px 26px; margin-bottom: 40px;
}
.hero__perks li {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 14px; font-weight: 500; color: rgba(255,255,255,.9);
}
.hero__perks li::before {
  content: "✓"; font-weight: 700; font-size: 13px; color: var(--white);
  width: 18px; height: 18px; border-radius: 50%;
  background: rgba(255,255,255,.16);
  display: inline-flex; align-items: center; justify-content: center; flex: none;
}

.hero__meta { list-style: none; display: flex; justify-content: center; gap: 42px; }
.hero__meta li { display: flex; flex-direction: column; }
.hero__meta strong { font-size: 24px; font-weight: 700; letter-spacing: -0.03em; color: var(--white); font-family: var(--font-display); }
.hero__meta span { font-size: 13px; color: rgba(255,255,255,.6); margin-top: 2px; }

/* Marquee */
.hero__marquee { border-block: 1px solid var(--accent-dark); overflow: hidden; padding: 16px 0; background: var(--accent); }
.marquee__track { display: flex; width: max-content; animation: marquee 40s linear infinite; will-change: transform; }
.marquee__group { display: flex; align-items: center; gap: 26px; padding-right: 26px; flex-shrink: 0; white-space: nowrap; }
.marquee__group span { font-family: 'Sora', var(--font-display); font-size: 18px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--bg); }
.marquee__group i { color: rgba(247,243,236,.45); font-style: normal; }
@keyframes marquee { to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .marquee__track, .announce__track, .reviews__track, .insta__track { animation: none; } }

/* =========================================================
   PRODUCT
   ========================================================= */
/* --- responsive (mobile above-fold) --- */
@media (max-width: 1080px) {
  .benefits__grid, .usecases__grid, .addons__grid { grid-template-columns: repeat(2, 1fr); }
  .reviews__grid { grid-template-columns: repeat(2, 1fr); }
  .footer__grid { grid-template-columns: 1fr 1fr; }
  .footer__news { grid-column: span 2; max-width: 520px; }
}

@media (max-width: 900px) {
  .nav { display: none; }
  .header__cta { display: none; }
  /* menu a gauche, logo a sa suite, panier a droite */
  .header__burger { display: flex; margin-left: -9px; margin-right: 6px; }
  .header .logo { margin-right: auto; }
  .header__mobile { display: flex; }
  .hero__inner { min-height: 88vh; padding-block: 60px; }
  .hero__overlay {
    background:
      linear-gradient(180deg, rgba(0,0,0,.34) 0%, rgba(0,0,0,.22) 50%, rgba(0,0,0,.44) 100%);
  }
  .product__grid { grid-template-columns: 1fr; }
  .gallery { position: static; }
  .reviews__top { grid-template-columns: 1fr; text-align: center; }
  .reviews__score { text-align: center; }
  .reviews__score .stars { margin-inline: auto; }
  .reviews__histo { margin-inline: auto; }
  .faq__inner { grid-template-columns: 1fr; }
  .faq__head { position: static; }
  .edito, .edito--reverse .edito__media { grid-template-columns: 1fr; order: 0; }
  .edito__media { order: -1 !important; }
}

@media (max-width: 640px) {
  .benefits__grid, .usecases__grid, .addons__grid, .reviews__grid, .insta__grid { grid-template-columns: 1fr; }
  .insta__grid { grid-template-columns: repeat(3, 1fr); }
  .hero__meta { gap: 26px; }
  .hero__cta { flex-direction: column; align-items: stretch; }
  .hero__cta .btn { width: 100%; }
  /* Contenu calé en bas du hero : le tapis rose reste visible en haut,
     et tout le bloc (texte + bouton + repères) tient dans le premier écran */
  .hero__inner { justify-content: flex-end; min-height: calc(100svh - 100px); padding-top: 20px; padding-bottom: 26px; }
  .hero__title { margin-bottom: 14px; }
  .hero__sub { margin-bottom: 18px; line-height: 1.5; }
  .hero__cta { margin-bottom: 16px; }
  .hero__perks { margin-bottom: 20px; }
  .gallery__thumbs { grid-template-columns: repeat(10, 1fr); }
  .footer__grid { grid-template-columns: 1fr; gap: 36px; }
  .footer__news { grid-column: auto; }
  .footer__bottom { flex-direction: column; text-align: center; }
  .sticky-cart { display: flex; }
  .product { padding-top: 40px; }
}

/* =========================================================
   LEGAL PAGES (Mentions légales · Confidentialité · CGV)
   ========================================================= */
.legal-header {
  position: sticky; top: 0; z-index: 100;
  background: rgba(255,255,255,.86); backdrop-filter: saturate(180%) blur(18px);
  border-bottom: 1px solid var(--line);
}
.legal-header__inner { display: flex; align-items: center; justify-content: space-between; height: 66px; }

.legal-hero {
  padding: clamp(56px, 9vw, 104px) 0 clamp(28px, 4vw, 48px);
  border-bottom: 1px solid var(--line);
}
.legal-hero .eyebrow { margin-bottom: 14px; }
.legal-hero h1 { font-size: clamp(32px, 5vw, 58px); letter-spacing: -0.04em; }
.legal-hero__updated { margin-top: 16px; font-size: 14px; color: var(--grey-600); }

.legal {
  max-width: 820px;
  padding-top: clamp(40px, 6vw, 72px);
  padding-bottom: clamp(64px, 9vw, 120px);
}
.legal__intro { font-size: 17px; color: var(--grey-600); line-height: 1.7; margin-bottom: 44px; }
.legal section { margin-bottom: 44px; scroll-margin-top: 90px; }
.legal h2 {
  font-size: clamp(20px, 2.4vw, 26px); letter-spacing: -0.03em; margin-bottom: 16px;
  padding-top: 8px;
}
.legal h2 .legal__num { color: var(--grey-300); font-weight: 700; margin-right: 12px; }
.legal h3 { font-size: 16px; font-weight: 700; margin: 26px 0 10px; letter-spacing: -0.02em; }
.legal p { font-size: 15.5px; color: #3a3a3a; line-height: 1.75; margin-bottom: 14px; }
.legal ul { list-style: none; display: grid; gap: 10px; margin: 8px 0 18px; }
.legal ul li { position: relative; padding-left: 22px; font-size: 15.5px; color: #3a3a3a; line-height: 1.7; }
.legal ul li::before {
  content: ""; position: absolute; left: 2px; top: 11px;
  width: 6px; height: 6px; border-radius: 50%; background: var(--ink-900);
}
.legal a:not(.btn) { color: var(--ink-900); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--grey-300); transition: text-decoration-color var(--dur) var(--ease); }
.legal a:not(.btn):hover { text-decoration-color: var(--ink-900); }
.legal strong { font-weight: 650; color: var(--ink-900); }

.legal__table { width: 100%; border-collapse: collapse; margin: 6px 0 20px; font-size: 15px; }
.legal__table th, .legal__table td { text-align: left; padding: 13px 16px; border: 1px solid var(--line); vertical-align: top; }
.legal__table th { background: var(--grey-100); font-weight: 650; width: 34%; }

.legal__todo {
  display: inline; background: #fff3cd; color: #7a5b00; border-radius: 4px;
  padding: 1px 7px; font-weight: 600; font-size: 0.95em; border: 1px solid #ffe08a;
}

.legal__box {
  background: var(--grey-100); border: 1px solid var(--line);
  border-radius: var(--radius-sm); padding: clamp(20px, 3vw, 30px); margin: 18px 0;
}
.legal__box p:last-child { margin-bottom: 0; }

.legal__contact { margin-top: 8px; }
.legal__contact p { margin-bottom: 6px; }

@media (max-width: 620px) {
  .legal__table th { width: 42%; }
  .legal-header__inner .btn { padding: 8px 16px; font-size: 13px; }
}

